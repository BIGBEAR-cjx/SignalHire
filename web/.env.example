# Copy to web/.env.local and fill in real values. Never commit .env.local.
#   cp web/.env.example web/.env.local

# MiroMind deep research.
# Required by worker/ for non-cached live research.
MIROMIND_API_KEY=your-miromind-api-key
MIROMIND_BASE_URL=https://api.miromind.ai/v1
MIROMIND_MODEL=mirothinker-1-7-deepresearch-mini

# Insforge server-side admin access. It is required for history, share links,
# queued live research, Credits RPCs, and the isolated Ops console.
# Server-only: do not add a NEXT_PUBLIC_ prefix to these values.
INSFORGE_API_BASE_URL=https://your-project.insforge.app
INSFORGE_API_KEY=your-insforge-access-key
# Exact email for the sole official operations account. Missing or malformed denies all ops APIs.
OPS_ADMIN_EMAIL=ops@example.com
# Bind this same Next.js app to this host (for example https://ops.example.com).
# The login cookie must remain host-only; do not set Domain=.example.com.
OPS_APP_ORIGIN=https://ops.example.com

# Insforge client auth base URL.
# Public browser auth SDK value.
NEXT_PUBLIC_INSFORGE_API_BASE_URL=https://your-project.insforge.app

# Optional free public evidence APIs used by worker search prechecks.
# Add these to the worker/server runtime, not to browser-exposed env.
GITHUB_TOKEN=your-github-token
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
OPENALEX_API_KEY=your-openalex-api-key
HF_TOKEN=your-hugging-face-token
ANYSEARCH_API_KEY=your-anysearch-api-key
OPEN_EVIDENCE_MAX_QUERIES=4

# Optional external Role Agent live signal provider. Leave empty to use the internal fallback.
LIVE_SIGNAL_PROVIDER_URL=https://your-live-signal-provider.example.com/refresh
LIVE_SIGNAL_PROVIDER_HEALTH_URL=https://your-live-signal-provider.example.com/health
LIVE_SIGNAL_PROVIDER_API_KEY=your-live-signal-provider-key

# Optional release QA settings.
SIGNALHIRE_QA_BASE_URL=http://127.0.0.1:3000
SIGNALHIRE_QA_USER_ID=your-qa-user-id
SIGNALHIRE_QA_EMAIL=qa@example.com
SIGNALHIRE_QA_JWT_SECRET=your-qa-jwt-secret
SIGNALHIRE_QA_SESSION_TOKEN=optional-existing-session-token
# Browser release QA needs separate owner and customer sessions plus a project fixture.
# Customer and disposable-customer sessions must belong to the test-only email/project
# fixture. Invite/revoke, feedback, and success actions are skipped unless
# SIGNALHIRE_QA_ALLOW_MUTATIONS=true.
SIGNALHIRE_QA_OWNER_SESSION_TOKEN=optional-owner-session-token
SIGNALHIRE_QA_CUSTOMER_SESSION_TOKEN=optional-customer-session-token
SIGNALHIRE_QA_PROJECT_ID=your-disposable-qa-project-id
SIGNALHIRE_QA_REPORT_ID=optional-qa-report-id
SIGNALHIRE_QA_DISPOSABLE_CUSTOMER_EMAIL=qa-customer@example.com
SIGNALHIRE_QA_DISPOSABLE_CUSTOMER_SESSION_TOKEN=optional-session-for-qa-customer@example.com
SIGNALHIRE_QA_FEEDBACK_NOTE=disposable-qa-feedback
SIGNALHIRE_QA_ALLOW_MUTATIONS=false
# Exact visible Role Agent CTA labels are required for browser verification of an owner
# success/error/busy state. Error/busy only intercept the current project's exact
# role-agent-runs POST locally; all other non-safe requests are aborted.
SIGNALHIRE_QA_ROLE_AGENT_SUCCESS_CTA=Run a disposable QA action
SIGNALHIRE_QA_ROLE_AGENT_ERROR_CTA=Refresh live signals
VERCEL_AUTOMATION_BYPASS_SECRET=your-vercel-automation-bypass-secret

# Optional customer portal invite email sending.
RESEND_API_KEY=your-resend-api-key
CLIENT_PORTAL_INVITE_FROM=SignalHire <delivery@example.com>
